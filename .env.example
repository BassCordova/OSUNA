# --- Base de datos PostgreSQL ---
# Cadena de conexión de tu Postgres (Neon, Vercel Postgres, Supabase, etc.)
# En Neon usa la URL "pooled". Ejemplo:
# postgresql://usuario:password@host/db?sslmode=require
DATABASE_URL=

# --- Autenticación (Auth.js / NextAuth) ---
# Secreto para firmar sesiones JWT. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# Opcional: en producción fuera de Vercel puede ser necesario.
# AUTH_TRUST_HOST=true
